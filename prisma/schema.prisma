generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum VideoStatus {
  pending
  processing
  completed
  failed
}

model Video {
  id           String      @id @default(uuid()) @db.Uuid
  youtubeId    String      @unique @map("youtube_id") @db.VarChar(20)
  url          String      @db.Text
  title        String?     @db.VarChar(500)
  durationSec  Int?        @map("duration_sec")
  language     String      @default("vi") @db.VarChar(10)
  status       VideoStatus @default(pending)
  errorMessage String?     @map("error_message") @db.Text
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime    @updatedAt @map("updated_at") @db.Timestamptz
  transcripts  Transcript[]
  chunks       Chunk[]
  summary      Summary?
  quizzes      Quiz[]
  flashcardSets FlashcardSet[]
  chatSessions ChatSession[]

  @@map("videos")
}

model Transcript {
  id        String   @id @default(uuid()) @db.Uuid
  videoId   String   @map("video_id") @db.Uuid
  rawText   String   @map("raw_text") @db.Text
  source    String   @db.VarChar(20)
  wordCount Int?     @map("word_count")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  video     Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  chunks    Chunk[]

  @@index([videoId], map: "idx_transcripts_video_id")
  @@map("transcripts")
}

model Chunk {
  id             String         @id @default(uuid()) @db.Uuid
  videoId        String         @map("video_id") @db.Uuid
  transcriptId   String         @map("transcript_id") @db.Uuid
  content        String         @db.Text
  chunkIndex     Int            @map("chunk_index")
  tokenCount     Int?           @map("token_count")
  startChar      Int?           @map("start_char")
  endChar        Int?           @map("end_char")
  embeddingId    String?        @map("embedding_id") @db.VarChar(100)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz
  video          Video          @relation(fields: [videoId], references: [id], onDelete: Cascade)
  transcript     Transcript     @relation(fields: [transcriptId], references: [id], onDelete: Cascade)
  quizQuestions  QuizQuestion[]
  flashcards     Flashcard[]

  @@index([videoId], map: "idx_chunks_video_id")
  @@index([transcriptId], map: "idx_chunks_transcript")
  @@index([videoId, chunkIndex], map: "idx_chunks_index")
  @@map("chunks")
}

model Summary {
  id               String   @id @default(uuid()) @db.Uuid
  videoId          String   @unique(map: "idx_summaries_video_id") @map("video_id") @db.Uuid
  keyPoints        Json     @map("key_points") @db.JsonB
  simplifiedText   String   @map("simplified_text") @db.Text
  mainTopics       Json?    @map("main_topics") @db.JsonB
  modelUsed        String?  @map("model_used") @db.VarChar(100)
  promptTokens     Int?     @map("prompt_tokens")
  completionTokens Int?     @map("completion_tokens")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz
  video            Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@map("summaries")
}

model Quiz {
  id             String        @id @default(uuid()) @db.Uuid
  videoId        String        @map("video_id") @db.Uuid
  title          String?       @db.VarChar(200)
  totalQuestions Int           @default(0) @map("total_questions")
  modelUsed      String?       @map("model_used") @db.VarChar(100)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz
  video          Video         @relation(fields: [videoId], references: [id], onDelete: Cascade)
  questions      QuizQuestion[]

  @@index([videoId], map: "idx_quizzes_video_id")
  @@map("quizzes")
}

model QuizQuestion {
  id             String   @id @default(uuid()) @db.Uuid
  quizId         String   @map("quiz_id") @db.Uuid
  questionText   String   @map("question_text") @db.Text
  options        Json     @db.JsonB
  correctOption  String   @map("correct_option") @db.Char(1)
  explanation    String?  @db.Text
  questionIndex  Int      @map("question_index")
  sourceChunkId  String?  @map("source_chunk_id") @db.Uuid
  quiz           Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  sourceChunk    Chunk?   @relation(fields: [sourceChunkId], references: [id])

  @@index([quizId], map: "idx_quiz_questions_quiz")
  @@map("quiz_questions")
}

model FlashcardSet {
  id         String      @id @default(uuid()) @db.Uuid
  videoId    String      @map("video_id") @db.Uuid
  title      String?     @db.VarChar(200)
  totalCards Int         @default(0) @map("total_cards")
  modelUsed  String?     @map("model_used") @db.VarChar(100)
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz
  video      Video       @relation(fields: [videoId], references: [id], onDelete: Cascade)
  flashcards Flashcard[]

  @@index([videoId], map: "idx_flashcard_sets_video")
  @@map("flashcard_sets")
}

model Flashcard {
  id            String   @id @default(uuid()) @db.Uuid
  setId         String   @map("set_id") @db.Uuid
  front         String   @db.Text
  back          String   @db.Text
  cardIndex     Int      @map("card_index")
  sourceChunkId String?  @map("source_chunk_id") @db.Uuid
  flashcardSet  FlashcardSet @relation(fields: [setId], references: [id], onDelete: Cascade)
  sourceChunk   Chunk?   @relation(fields: [sourceChunkId], references: [id])

  @@index([setId], map: "idx_flashcards_set")
  @@map("flashcards")
}

model ChatSession {
  id        String        @id @default(uuid()) @db.Uuid
  videoId   String        @map("video_id") @db.Uuid
  title     String        @default("New Chat") @db.VarChar(200)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime      @updatedAt @map("updated_at") @db.Timestamptz
  video     Video         @relation(fields: [videoId], references: [id], onDelete: Cascade)
  messages  ChatMessage[]

  @@index([videoId], map: "idx_chat_sessions_video")
  @@map("chat_sessions")
}

model ChatMessage {
  id                String   @id @default(uuid()) @db.Uuid
  sessionId         String   @map("session_id") @db.Uuid
  role              String   @db.VarChar(20)
  content           String   @db.Text
  retrievedChunks   Json?    @map("retrieved_chunks") @db.JsonB
  promptTokens      Int?     @map("prompt_tokens")
  completionTokens  Int?     @map("completion_tokens")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz
  session           ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId], map: "idx_chat_messages_session")
  @@index([sessionId, createdAt], map: "idx_chat_messages_created")
  @@map("chat_messages")
}
